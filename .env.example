# Compose configuration only. These values contain no credentials.
# T3 must be reachable from the container on a private network.
QP_T3_ORIGIN=http://host.docker.internal:3773
QP_T3_PUBLIC_ORIGIN=http://127.0.0.1:3773
QP_PUBLIC_ORIGIN=http://127.0.0.1:4317
